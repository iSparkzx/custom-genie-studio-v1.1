# Custom Genie server settings
# 1) Paste ONE key after the = sign and save this file. No quotes needed.
#    OpenRouter key (starts with sk-or-): needs credits at https://openrouter.ai/settings/credits
#    Google Gemini API key (starts with AIza): needs billing on (Nano Banana Pro has no free tier)
# 2) The server picks up the change by itself. Keep this file private: never put the key in the web page.
OPENROUTER_API_KEY=
GEMINI_API_KEY=

# Optional (remove the # at the start of a line to use it)
# GENIE_IMAGE_MODEL=gemini-3-pro-image    # Nano Banana Pro (OpenRouter: google/gemini-3-pro-image). gemini-3.1-flash-image = Nano Banana 2, about half the price
# GENIE_IMAGES_PER_REQUEST=2              # logos per request, 1 to 4 (each about $0.134 at 1K or 2K)
# GENIE_IMAGE_SIZE=2K                     # 1K or 2K (same price), or 4K (about $0.24)
# GENIE_RATE_PER_10MIN=8                  # requests allowed per visitor every 10 minutes
# GENIE_DAILY_IMAGE_LIMIT=200             # images per day for everyone combined (200 x $0.134 = about $27 a day max)
# GENIE_ALLOWED_ORIGINS=https://www.example.com   # only if the studio page is hosted on a different domain
# GENIE_MOCK=1                            # test mode: fake logos, no Google calls, no cost
# GENIE_TEAM_PASSWORD=                   # set this on a shared test link: the browser asks for it once (any user name)
# GENIE_SITE_URL=https://www.example.com  # your site, shown to OpenRouter as the app's address
# PORT=8765

# Genie chat (the assistant that asks questions, then sends the prompt to Nano Banana Pro). Uses the same key.
# GENIE_CHAT_MODEL=google/gemini-3.8-flash   # any OpenRouter chat model with tool calling. Measured about $0.002 per chat turn
# GENIE_CHAT_RATE_PER_10MIN=40              # chat messages allowed per visitor every 10 minutes
# GENIE_DAILY_CHAT_LIMIT=3000               # chat messages per day for everyone combined
# GENIE_CHAT=off                            # turn the chat off; Genie falls back to its built-in rules
