  "editor": {
    "mode": "template_layout",
    "fields": [
      "name",
      "title",
      "logo",
      "background"
    ],
    "layouts": "products/families/badge-layouts.json (Doogma layout masters, layouts 1 to 7)",
    "genie": true
  },
  "personalization": {
    "bulk_names": "BigCommerce 'Additional Names - File Upload' modifier (a names file, up to 5 MB)",
    "preview_every_name": true
  },
  "checks": {
    "safe_margin_in": 0.08,
    "min_text_pt": 6,
    "min_contrast": 3,
    "source": "Studio judgment until production confirms: 6 pt is a common minimum for printed and engraved text; contrast 3:1 is the WCAG minimum for large text."
  },
