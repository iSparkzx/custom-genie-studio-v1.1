{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/iSparkzx/custom-genie-studio-v1.1/products/schema/product-definition.schema.json",
  "title": "Custom Genie product definition",
  "description": "One customizable product. Generated by scripts/bigcommerce/build-definitions.mjs from a read-only BigCommerce pull plus products/families/<family>.json. Do not edit generated files by hand: change the family file or BigCommerce, then regenerate.",
  "type": "object",
  "required": ["id", "name", "family", "status", "studio_status", "bigcommerce", "size", "decoration", "pricing", "editor", "cart", "mcp", "todo"],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9_]+$", "description": "Stable id, from the BigCommerce URL slug. Same value as mcp.product_id." },
    "name": { "type": "string" },
    "family": { "enum": ["sticker", "badge", "pen"] },
    "type": { "type": ["string", "null"], "description": "Product type as grouped in BigCommerce (custom field dp_product), e.g. 'Sheets - Domed'." },
    "group": { "type": ["string", "null"], "description": "Products of the same type (e.g. the four domed sheets) can be shown as one product with a finish choice." },
    "status": { "enum": ["live", "hidden"] },
    "studio_status": { "enum": ["built", "planned"], "description": "built = the new studio supports it today." },
    "bigcommerce": {
      "type": "object",
      "required": ["product_id", "url"],
      "properties": {
        "product_id": { "type": "integer" },
        "url": { "type": "string" },
        "sku": { "type": ["string", "null"] },
        "base_variant_id": { "type": ["integer", "null"] },
        "template": { "type": ["string", "null"] }
      }
    },
    "size": {
      "type": "object",
      "required": ["mode", "unit"],
      "properties": {
        "mode": { "enum": ["free", "preset", "fixed"], "description": "free = shopper picks width and height in a range; preset = named sizes; fixed = one size." },
        "unit": { "const": "in" },
        "width": { "$ref": "#/$defs/range" },
        "height": { "$ref": "#/$defs/range" },
        "price_steps": { "type": "object", "description": "Sizes BigCommerce prices. A size in between is priced at the next step up." },
        "rounding": { "const": "up_to_next_step" },
        "presets": { "type": "array", "items": { "type": "object", "required": ["id", "label"], "properties": { "id": { "type": "string" }, "label": { "type": "string" }, "w_in": { "type": ["number", "null"] }, "h_in": { "type": ["number", "null"] } } } },
        "w_in": { "type": ["number", "null"] },
        "h_in": { "type": ["number", "null"] }
      }
    },
    "shapes": { "type": "array", "items": { "type": "object", "required": ["id", "bigcommerce_label"] } },
    "corners": { "type": "object" },
    "materials": { "type": "array", "items": { "type": "string" } },
    "background_colors": { "type": "array", "items": { "type": "string" } },
    "border_colors": { "type": "array", "items": { "type": "string" } },
    "attachments": { "type": "array", "items": { "type": "string" } },
    "product_colors": { "type": "array", "items": { "type": "string" } },
    "decoration": { "enum": ["printed", "engraved", "cut_vinyl"] },
    "format": { "type": ["string", "null"] },
    "dome": { "type": "boolean" },
    "sheet_in": { "type": "object" },
    "text_fields": { "type": "array", "items": { "type": "string" } },
    "fonts": { "type": "array", "items": { "type": "string" } },
    "personalization": { "type": ["object", "null"] },
    "quantity": { "type": "object" },
    "pricing": {
      "type": "object",
      "required": ["source", "pulled_at", "base_price", "quantity_tiers", "variants"],
      "properties": {
        "source": { "const": "bigcommerce_variants" },
        "pulled_at": { "type": "string" },
        "base_price": { "type": "number" },
        "quantity_tiers": { "type": "array", "items": { "type": "object", "required": ["min_qty", "type", "amount"] } },
        "variants": { "type": "array", "items": { "type": "object", "required": ["id", "price", "options"] } },
        "price_grid": { "type": "object", "description": "free-size products: 'HxW' (inches) to price per piece." }
      }
    },
    "editor": { "type": "object" },
    "checks": { "type": ["object", "null"] },
    "previews": { "type": "array", "items": { "type": "string" } },
    "cut_border_in_options": { "type": "array", "items": { "type": "number" } },
    "cart": { "type": "object", "required": ["options", "modifiers", "required_modifiers"] },
    "mcp": { "type": "object", "required": ["product_id", "studio_supported"] },
    "assumptions": { "type": "array", "items": { "type": "string" } },
    "todo": { "type": "array", "items": { "type": "string" } }
  },
  "$defs": {
    "range": { "type": ["object", "null"], "properties": { "min": { "type": "number" }, "max": { "type": "number" } } }
  }
}
